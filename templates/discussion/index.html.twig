{% extends 'base.html.twig' %}

{% block title %}Messaging-API - Discussions{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>{{ controller_name }} list ✅</h1>

    <ul>
        {% for discussion in discussions %}
            <li>
                <a href="{{ path('app_discussion.show', {id: discussion.id}) }}">Discussion with sender {{ discussion.sender.id }} and reciver {{ discussion.receiver.id }}</a>
            </li>
        {% endfor %}
    </ul>

</div>
{% endblock %}
